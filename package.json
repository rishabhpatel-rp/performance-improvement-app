{
  "name": "performance-improvement-app",
  "private": true,
  "scripts": {
    "build": "react-router build",
    "predev": "prisma generate",
    "postinstall": "prisma generate",
    "dev": "shopify app dev",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "react-router-serve ./build/server/index.js",
    "docker-start": "npm run setup && npm run start",
    "worker": "tsx app/worker/audit-worker.ts",
    "docker-start-worker": "npm run worker",
    "setup": "prisma generate && prisma migrate deploy",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "shopify": "shopify",
    "prisma": "prisma",
    "graphql-codegen": "graphql-codegen",
    "vite": "vite",
    "typecheck": "react-router typegen && tsc --noEmit",
    "format": "prettier --write \"app/**/*.{js,jsx,ts,tsx}\" \"tests/**/*.js\" \"scripts/**/*.{mjs,ts}\"",
    "format:check": "prettier --check \"app/**/*.{js,jsx,ts,tsx}\" \"tests/**/*.js\" \"scripts/**/*.{mjs,ts}\"",
    "test": "node --import tsx --test \"tests/*.test.js\" \"Test Data/*.test.js\"",
    "test:integration": "node ./node_modules/tsx/dist/cli.mjs --env-file=.env --test tests/audit-queue.integration.test.ts",
    "test:storefront-smoke": "node scripts/storefront-smoke.mjs",
    "rollout:audit-queue": "bash scripts/rollout-audit-queue-local.sh",
    "prepare": "husky",
    "check:schema": "node scripts/check-schema-drift.mjs",
    "retention": "node --import tsx scripts/retention-cleanup.ts"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@react-router/dev": "^7.12.0",
    "@react-router/fs-routes": "^7.12.0",
    "@react-router/node": "^7.12.0",
    "@react-router/serve": "^7.12.0",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/shopify-app-react-router": "^1.2.1",
    "@shopify/shopify-app-session-storage-prisma": "^9.0.0",
    "isbot": "^5.1.31",
    "javascript-obfuscator": "^5.7.0",
    "playwright": "^1.62.1",
    "pm2": "^7.0.4",
    "prisma": "^6.19.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.12.0",
    "tsx": "^4.19.2",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "devDependencies": {
    "@shopify/api-codegen-preset": "^1.2.0",
    "@shopify/app": "^3.58.2",
    "@shopify/cli": "^4.7.0",
    "@shopify/polaris-types": "^1.0.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.18.8",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "graphql-config": "^6.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^6.3.6"
  },
  "workspaces": [
    "extensions/*"
  ],
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "overrides": {
    "p-map": "^4.0.0"
  },
  "author": "rishabh.patel@brainvire.com",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,css,md,yml,yaml}": "prettier --write --ignore-unknown",
    "app/**/*.{js,jsx,ts,tsx}": "eslint --max-warnings=0 --no-cache",
    "tests/**/*.{js,ts}": "eslint --max-warnings=0 --no-cache"
  }
}
