// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// This is the source of truth for Session/Store/StoreConfig/StoreActivity/
// AdminUser/PerformanceScript — admin-panel/prisma/schema.prisma mirrors
// these models against the same shared Postgres database. See the
// DECISION NEEDED note at the top of that file: until (a) a shared-package
// import or (b) an explicit partial-read-model process is chosen, treat
// every change to a shared model here as needing a manual copy over there
// too (checklist item: "does this reach admin-panel/prisma/schema.prisma?").

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// MODEL 1: Session (migrated from SQLite, same structure)
// Used by PrismaSessionStorage for Shopify OAuth sessions
// ============================================================
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// ============================================================
// TEAM MEMBER MODELS: Client store data collection
// ============================================================
model AppTracking {
  id                  Int       @id @default(autoincrement())
  store_name          String
  email               String
  domain              String    @unique
  location            String?
  timezone            String?
  installation_time   DateTime  @default(now())
  uninstallation_time DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  domain     String
  audit_type String   @default("general")
  audit_data Json?
  timestamp  DateTime @default(now())
  status     String   @default("completed")
  details    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([domain])
  @@index([timestamp])
}

// ============================================================
// MODEL 2: Store
// Stores details about each Shopify store that installs the app.
// Created on first dashboard visit (after OAuth), updated on uninstall.
// ============================================================
model Store {
  id String @id @default(cuid())

  // Shopify identifiers
  shopifyShopId String @unique // Shopify's numeric shop ID or domain
  shopDomain    String @unique // e.g. "mystore.myshopify.com"

  // Store details (fetched via GraphQL shop query on first visit)
  shopName     String // Store name (shop.name)
  email        String // Store owner email (shop.email)
  country      String? // Country code (e.g. "US")
  countryName  String? // Country name (e.g. "United States")
  city         String? // City
  address1     String? // Street address line 1
  address2     String? // Street address line 2
  zip          String? // Postal code
  timezone     String? // Human-readable timezone (e.g. "(GMT-05:00) Eastern Time")
  ianaTimezone String? // IANA timezone (e.g. "America/New_York")
  currency     String? // Currency code (e.g. "USD")
  locale       String? // Primary locale (e.g. "en")

  // Plan & stats
  shopifyPlan      String? // Plan display name (e.g. "Shopify Plus", "Basic Shopify")
  totalProducts    Int? // Product count (from productsCount query)
  totalOrders      Int? // Order count (from ordersCount query)
  createdAtShopify DateTime? // When the shop was created on Shopify

  // App lifecycle tracking
  installedAt   DateTime  @default(now()) // When THIS app was installed
  uninstalledAt DateTime? // When the app was uninstalled (null = still active)
  isActive      Boolean   @default(true) // false after uninstall
  currentScope  String? // Current OAuth access scopes

  // Sync tracking
  lastSyncedAt DateTime? // Last time we synced config from metaobjects

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  configs           StoreConfig[]
  activities        StoreActivity[]
  performanceScript PerformanceScript?
  auditJobs         AuditJob[]

  @@index([isActive])
  @@index([installedAt])
}

model AuditJob {
  id            String    @id @default(cuid())
  storeId       String
  store         Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  shopDomain    String
  status        String    @default("queued")
  attempts      Int       @default(0)
  runAt         DateTime  @default(now())
  lockedAt      DateTime?
  stopRequested Boolean   @default(false)
  lastError     String?
  payload       Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, runAt])
  @@index([shopDomain])
}

model PsiSnapshot {
  id              String   @id @default(cuid())
  shopDomain      String
  url             String
  strategy        String   @default("mobile")
  fieldSource     String
  lcp             Int?
  inp             Int?
  cls             Int?
  lighthouseScore Int?
  rawJson         Json?
  fetchedAt       DateTime @default(now())

  @@index([shopDomain, fetchedAt])
}

// ============================================================
// MODEL 3: StoreConfig
// Mirrors the Shopify metaobject config for each store.
// Synced on every dashboard load and config change.
// ============================================================
model StoreConfig {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  // Script toggles
  appEnabled     Boolean @default(false)
  script1Enabled Boolean @default(false) // Audit script
  script2Enabled Boolean @default(false) // Defer script
  script3Enabled Boolean @default(false) // Hide CSS script
  debugMode      Boolean @default(false)
  auditComplete  Boolean @default(false)

  // Script data (stored as JSON arrays)
  scriptTitles       Json @default("[]") // ["Title1","Title2","Title3"]
  auditDeferArray    Json @default("[]") // Union fallback (all template defer scopes)
  auditHideSelectors Json @default("[]") // Union fallback (all template hide scopes)
  staticDeferDefaults Json @default("[\"wpm\",\"gtm\"]") // Union fallback for every-visit delay scripts

  auditDeferGlobal      Json @default("[]")
  auditDeferHome        Json @default("[]")
  auditDeferCollection  Json @default("[]")
  auditDeferProduct     Json @default("[]")
  auditHideGlobal       Json @default("[]")
  auditHideHome         Json @default("[]")
  auditHideCollection   Json @default("[]")
  auditHideProduct      Json @default("[]")
  staticDeferDefaultsGlobal      Json @default("[\"wpm\",\"gtm\"]")
  staticDeferDefaultsHome        Json @default("[]")
  staticDeferDefaultsCollection  Json @default("[]")
  staticDeferDefaultsProduct     Json @default("[]")

  // Audit field toggle states (on/off) — Step 3 "Audit Results" textareas
  auditDeferArrayEnabled      Boolean @default(true)
  auditHideSelectorsEnabled   Boolean @default(true)
  staticDeferDefaultsEnabled  Boolean @default(true)

  // Preserved snapshot (taken when a field is toggled OFF so it can be
  // restored on toggle ON; the "active" column holds [] while OFF).
  auditDeferArrayPreserved      Json @default("[]")
  auditHideSelectorsPreserved   Json @default("[]")
  staticDeferDefaultsPreserved  Json @default("[]")

  storefrontPassword String?   // Owner's storefront password — used to bypass the password page during audit

  // Cached values for fast path
  isPasswordProtected Boolean? // true/false once confirmed (storefront redirect probe + Shopify setting); NULL = not determined yet
  cachedAppEndpoint   String?                 // Last known SHOPIFY_APP_URL + /audit-submit for Gate C check

  // Custom page URLs for audit (merchant-specified, optional)
  customPlpUrl String?  // Merchant-specified PLP URL
  customPdpUrl String?  // Merchant-specified PDP URL
  // Extra pages the merchant added with the "+" button in Step 1. These have no
  // PLP/PDP semantics — they are audited as generic pages and only contribute to
  // the union (never a per-page variant), because their page type is unknown.
  customPageUrls Json @default("[]")

  // Reference to the Shopify metaobject
  metaobjectId String?

  // ============================================================
  // First User Delay Scripts (maps to FIRST_USER_DELAY_SCRIPTS in script)
  // Only runs for first-time visitors (localStorage check)
  // ============================================================
  firstUserDelayScripts          Json    @default("[\"wpm\",\"gtm\"]") // Union fallback
  firstUserDelayScriptsEnabled   Boolean @default(true)
  firstUserDelayScriptsPreserved Json    @default("[]")
  firstUserDelayMs               Int     @default(12000)  // Legacy; mirrors Global

  firstUserDelayScriptsGlobal      Json @default("[\"wpm\",\"gtm\"]")
  firstUserDelayScriptsHome        Json @default("[]")
  firstUserDelayScriptsCollection  Json @default("[]")
  firstUserDelayScriptsProduct     Json @default("[]")
  firstUserDelayMsGlobal      Int @default(12000)
  firstUserDelayMsHome        Int @default(12000)
  firstUserDelayMsCollection  Int @default(12000)
  firstUserDelayMsProduct     Int @default(12000)

  // ============================================================
  // Delay time for "Delay Scripts" box (EVERY_TIME_DELAY_SCRIPTS)
  // ============================================================
  everyTimeDelayMs               Int     @default(6000)   // Legacy; mirrors Global
  everyTimeDelayMsGlobal      Int @default(6000)
  everyTimeDelayMsHome        Int @default(6000)
  everyTimeDelayMsCollection  Int @default(6000)
  everyTimeDelayMsProduct     Int @default(6000)

  // Audit status (hidden backend audit lifecycle)
  auditRunning Boolean @default(false)
  auditFailed  Boolean @default(false)
  auditError   String?
  lastAuditAt  DateTime?
  auditPageIndex  Int? // 0-based page currently being audited (for progress UI)
  auditTotalPages Int? // total pages in the audit run
  auditPages         Json?      // [{ label, path }] pages discovered for the current/last audit (paths only, no query)
  auditPageStartedAt DateTime?  // when the page currently being audited started (countdown survives refresh)
  auditPhase         String?    // "discovering" | "auditing" | "building" while auditRunning; null otherwise. auditPageIndex = pages finished.
  activeAuditJobId   String?    // AuditJob.id while auditRunning; cleared when job ends

  // Theme the app extension (theme app embed) is installed in. null = live (MAIN) theme.
  selectedThemeId String? // e.g. "gid://shopify/OnlineStoreTheme/123"

  // Automated layout/theme.liquid head injection (themeFilesUpsert); see theme-head-inject.server.ts
  themeHeadInjectStatus       String?   // not_attempted | skipped | injected | exempt_denied | error
  themeHeadInjectAttemptedAt  DateTime?
  themeHeadInjectError        String?

  // PageSpeed Insights field layer (async after audit; AUDIT-SYSTEM-OCT-12 Phase 4)
  psiFieldVitals    Json?
  psiLastFetchedAt  DateTime?
  psiBackoffUntil   DateTime?
  // _bt + key (+ preview_theme_id) from theme Share preview — PSI on password stores
  psiPreviewBypassParams Json?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId])
}

// ============================================================
// MODEL 4: StoreActivity
// Event log for each store. Every significant action creates
// an activity record for the admin panel timeline.
// ============================================================
model StoreActivity {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  eventType   String // Event type (see IMPLEMENTATION_PLAN_5.md)
  description String? // Human-readable description
  metadata    Json? // Additional event-specific data

  createdAt DateTime @default(now())

  @@index([storeId])
  @@index([eventType])
  @@index([createdAt])
}

// ============================================================
// MODEL 5: AdminUser
// Admin panel login credentials. Passwords hashed with bcrypt.
// ============================================================
model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  role         String    @default("admin") // "admin" or "viewer"
  // Bumped on password change. It is copied into the session cookie and
  // compared in requireAdmin(), so changing a password revokes every session
  // that was issued before the change.
  sessionVersion Int     @default(0)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ============================================================
// MODEL 6: PerformanceScript
// Store script that will be used on the storefront side.
// ============================================================
model PerformanceScript {
  id      String @id @default(cuid())
  storeId String @unique // Makes relation 1:1 per store
  store   Store  @relation(fields: [storeId], references: [id])

  auditScript String?  @map("audit_script") // legacy (raw audit report JSON); no longer written or read
  // Final obfuscated storefront script, built by rebuildPerformanceScript() whenever
  // its inputs change. Served as-is by the app proxy (fallback) and mirrored
  // byte-for-byte into the shop metafield that the theme app embed renders inline.
  deferScript String?  @map("defer_script")
  hiddenCss   String?  @map("hidden_css") // plain hide-lastfold CSS (already embedded in deferScript)
  scriptHash    String?   @map("script_hash") // sha256 of deferScript, used as the HTTP ETag
  scriptBuiltAt DateTime? @map("script_built_at")
  // Fingerprint of the raw script + obfuscation profile/seed/debug flag. When it is
  // unchanged, rebuildPerformanceScript() reuses deferScript instead of obfuscating
  // again ("off" while the app is disabled).
  inputsHash        String?   @map("inputs_hash")
  // scriptHash currently live in the shop metafield rendered inline by the theme
  // app embed (null = no inline script; storefront falls back to the app proxy).
  metafieldHash     String?   @map("metafield_hash")
  metafieldSyncedAt DateTime? @map("metafield_synced_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([storeId])
  @@map("performance_scripts")
}
