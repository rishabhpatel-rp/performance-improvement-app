{%- comment -%}
  Same bytecode as GET /apps/performance-scripts: the app stores
  PerformanceScript.deferScript in $app:pagepulse shop metafields (see
  script-metafield.server.ts). This block prints it as one inline <script>
  (no extra network round-trip). Open the app once after enable/rebuild so
  metafields sync if the embed is blank.

  compliance_head = earliest app-embed slot in <head>. When theme liquid
  injection is active (theme_head_active), this embed skips to avoid double run.
{%- endcomment -%}
{%- unless app.metafields.pagepulse.theme_head_active -%}
{% render 'pagepulse-inline' %}
{%- endunless -%}

{% schema %}
{
  "name": "Performance Script Loader",
  "target": "compliance_head",
  "settings": []
}
{% endschema %}
