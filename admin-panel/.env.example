# Same database as the merchant app (admin has no migrations of its own).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/performance_app?schema=public"
# Generate with: openssl rand -base64 48   (must be >= 32 chars or the app
# refuses to boot — see src/lib/auth.ts. The short value below is an
# intentional placeholder that FAILS that check so it can never be deployed.
ADMIN_SESSION_PASSWORD=REPLACE_ME

# Set to "true" to serve hard-coded dummy data on all admin pages instead of
# reading from the database (useful for UI review). Remove before go-live.
SHOW_DUMMY_DATA="false"

# Merchant app origin. A trailing slash is ignored. Either name works;
# PAGEPULSE_INTERNAL_URL wins when both are set. `node scripts/sync-admin-merchant-url.mjs`
# keeps every variable that is present in agreement.
# Local dev: merchant Vite port (root .env PORT=9001), not the admin Next.js port.
PAGEPULSE_APP_URL="http://127.0.0.1:9001"
# PAGEPULSE_INTERNAL_URL=

# Shared secret with the merchant app (openssl rand -base64 32). Both apps accept
# either name (INTERNAL_API_SECRET first); the VALUE must be identical in the
# root .env and here.
ADMIN_INTERNAL_SECRET=REPLACE_ME
# INTERNAL_API_SECRET=

# Merchant app only (root .env): allow admin "Force ON" in production.
# ADMIN_ALLOW_FORCE_APP_ON=true

# Merchant app audit queue (set on the PagePulse root .env, not here unless you run the worker locally):
# AUDIT_USE_DB_QUEUE=false
# AUDIT_WORKER_ENABLED=true
# Poll queue metrics from admin automation: POST merchant /api/internal/audit-metrics (same secret as above).

# Only needed when this panel reads an encrypted storefront password.
# STOREFRONT_PASSWORD_KEY=
