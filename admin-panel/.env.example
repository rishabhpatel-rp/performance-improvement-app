DATABASE_URL="postgresql://admin:devpassword123@localhost:5432/performance_app?schema=public"
# Generate with: openssl rand -base64 48   (must be >= 32 chars or the app
# refuses to boot — see src/lib/auth.ts. The short value below is an
# intentional placeholder that FAILS that check so it can never be deployed.
ADMIN_SESSION_PASSWORD=REPLACE_ME

# Set to "true" to serve hard-coded dummy data on all admin pages instead of
# reading from the database (useful for UI review). Remove before go-live.
SHOW_DUMMY_DATA="false"
