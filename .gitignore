# `npm test` still picks these up (see the "test" script in package.json).
/Test Data/

# gocryptfs key material must NEVER be committed: gocryptfs.conf holds the
# scrypt-wrapped master key and gocryptfs.diriv is the directory IV.
admin-panel/admindata/
